generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  TEACHER
}

enum Level {
  Beginner
  Intermediate
  Advanced
}
enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
}
model User {
  clerkId        String   @id
  email          String   @unique
  fullName       String
  phoneNumber    String?
  role           UserRole @default(USER)
  membershipType Boolean  @default(false)
  isTrialUsed    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings   Booking[]
  membership Membership?

  @@index([clerkId])
}

model Teacher {
  id         String   @id @default(cuid())
  fullName   String
  bio        String
  experience String
  imageUrl   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sections Section[]
}

model Section {
  id        String   @id @default(cuid())
  title     String
  level     Level    @default(Beginner)
  teacherId String
  StartTime DateTime
  endTime   DateTime
  capacity  Int
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher  Teacher   @relation(fields: [teacherId], references: [id])
  bookings Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  clerkId   String
  sectionId String
  status    Boolean  @default(false)
  isTrial   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [clerkId], references: [clerkId], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([clerkId, sectionId])
  @@index([clerkId])
  @@index([sectionId])
}

model Membership {
  clerkId String @id
  user    User   @relation(fields: [clerkId], references: [clerkId])

  // Анх Pending байхад хугацаа тодорхойгүй байж болох тул DateTime? (Optional) болгохыг зөвлөе
  startDate     DateTime? 
  endDate       DateTime? 
  
  totalSessions Int      @default(0)
  usedSessions  Int      @default(0)
  
  // Энд String-ийн оронд enum-аа зааж өгнө
  status        MembershipStatus @default(PENDING)

  history MembershipHistory[]
}

model MembershipHistory {
  id           String     @id @default(cuid())
  clerkId      String     
  membership   Membership @relation(fields: [clerkId], references: [clerkId], onDelete: Cascade)

  action String 
  change Int 

  createdAt DateTime @default(now())

  @@index([clerkId])
}
